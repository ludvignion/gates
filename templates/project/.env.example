# OPIK_URL_OVERRIDE: local URL or explicit cloud URL. Key and workspace: cloud only.
OPIK_URL_OVERRIDE=
OPIK_PROJECT_NAME=
OPIK_API_KEY=
OPIK_WORKSPACE=

# GH_TOKEN: kanban/.issues opt-in only. Needed for unattended (Docker) runner.py runs; a local
# session uses the machine's stored `gh auth` login instead. Scope: Issues read and write on the
# project repo (a fine-grained token restricted to that repo is enough).
GH_TOKEN=
